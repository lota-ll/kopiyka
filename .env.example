# Скопіюй у .env та відредагуй. .env у git НЕ комітиться.

KOPIYKA_ENV=local
KOPIYKA_LOG_LEVEL=INFO

# --- База даних -------------------------------------------------------------
# Застосунок ходить під kopiyka_app — роллю БЕЗ прав власника таблиць.
# Це обов'язкова умова роботи RLS.
KOPIYKA_DATABASE_URL=postgresql+asyncpg://kopiyka_app:devpass@localhost:5432/kopiyka
# Міграції виконуються від власника.
KOPIYKA_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:devpass@localhost:5432/kopiyka

# --- Object storage (S3-сумісне) --------------------------------------------
# Порожній endpoint = справжній AWS S3. MinIO локально, R2 у production.
KOPIYKA_S3_ENDPOINT_URL=http://localhost:9000
KOPIYKA_S3_BUCKET=kopiyka-imports
KOPIYKA_S3_ACCESS_KEY=minioadmin
KOPIYKA_S3_SECRET_KEY=minioadmin
KOPIYKA_RAW_STATEMENT_RETENTION_DAYS=7

# --- Автентифікація ---------------------------------------------------------
# dev — тільки для local. cf_access — фаза 1. oidc — з тижня 7.
KOPIYKA_AUTH_MODE=dev
KOPIYKA_INVITE_ONLY=true
# KOPIYKA_CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# KOPIYKA_CF_ACCESS_AUD=
